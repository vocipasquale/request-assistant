<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Template di una singola PendingDecision.
    Istanziato dal controller per ogni PendingDecision caricata.

    Binding atteso dal controller (PendingDecisionCardController):
      - createdAtLabel  → PendingDecision.createdAt
      - targetLabel     → PendingDecision.target
      - optionsTable    → ObservableList<DecisionOption>
      - onAccept()      → handler accettazione
      - onDelete()      → handler eliminazione pendingDecision
      - onDeleteOption  → handler colonna "Elimina" nella tabella
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.requestassistant.dashboard.view.PendingDecisionCardController"
      styleClass="pending-decision-card" spacing="8.0" >

    <!-- Header: campi + pulsanti -->
    <HBox spacing="12.0" styleClass="card-header" alignment="CENTER_LEFT">

        <!-- Campi createdAt e target -->
        <VBox HBox.hgrow="ALWAYS" spacing="4.0">
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label text="Data:" styleClass="card-field-label"/>
                <Label fx:id="createdAtLabel" text="—" styleClass="card-field-value"/>
            </HBox>
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label text="Target:" styleClass="card-field-label"/>
                <Label fx:id="targetLabel" text="—" styleClass="card-field-value"/>
            </HBox>
        </VBox>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="deleteCardButton" text="Elimina"
                styleClass="delete-button"
                onAction="#onDelete"/>
    </HBox>

    <Separator styleClass="card-separator"/>

    <!-- ── Sezione opzioni ── -->
    <Label text="Opzioni:" styleClass="card-section-label"/>

    <TableView fx:id="optionsTable" prefHeight="140" styleClass="options-table" >
        <columns>
            <TableColumn fx:id="actionColumn"     text="Action"     prefWidth="160"/>
            <TableColumn fx:id="confidenceColumn" text="Confidence" prefWidth="100"/>
            <TableColumn fx:id="reasonColumn"     text="Reason"     prefWidth="260"/>
            <TableColumn fx:id="deleteOptionColumn" text=""         prefWidth="80"/>
        </columns>
    </TableView>

</VBox>

