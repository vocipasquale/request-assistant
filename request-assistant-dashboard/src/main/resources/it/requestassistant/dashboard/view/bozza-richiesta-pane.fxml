<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Bozza richiesta -->

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      spacing="10.0" prefWidth="640.0" prefHeight="520.0" styleClass="pending-decision-card">

    <padding>
        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
    </padding>

    <HBox fx:id="bozzaRichiestaBox" spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Bozza richiesta" styleClass="card-section-label"/>
    </HBox>

    <Label text="Richiesta" styleClass="card-field-label"/>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Titolo:" styleClass="card-field-label" minWidth="80.0"/>
        <TextField fx:id="titoloField" promptText="Titolo della richiesta" styleClass="mail-editable-field" style="-fx-control-inner-background: white; -fx-background-color: white;" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Stato:" styleClass="card-field-label" minWidth="80.0"/>
        <TextField fx:id="statoField" promptText="Stato della richiesta" styleClass="mail-editable-field" style="-fx-control-inner-background: white; -fx-background-color: white;" HBox.hgrow="ALWAYS"/>
    </HBox>

    <TitledPane text="Utente" collapsible="false" expanded="true">
        <content>
            <VBox spacing="10.0">
                <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                </padding>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Cognome:" styleClass="card-field-label" minWidth="110.0"/>
                    <TextField fx:id="cognomeField" promptText="Cognome utente" styleClass="mail-editable-field" style="-fx-control-inner-background: white; -fx-background-color: white;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Nome:" styleClass="card-field-label" minWidth="110.0"/>
                    <TextField fx:id="nomeField" promptText="Nome utente" styleClass="mail-editable-field" style="-fx-control-inner-background: white; -fx-background-color: white;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Codice fiscale:" styleClass="card-field-label" minWidth="110.0"/>
                    <TextField fx:id="codiceFiscaleField" promptText="Codice fiscale utente" styleClass="mail-editable-field" style="-fx-control-inner-background: white; -fx-background-color: white;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Email:" styleClass="card-field-label" minWidth="110.0"/>
                    <TextField fx:id="emailField" promptText="Email utente" styleClass="mail-editable-field" style="-fx-control-inner-background: white; -fx-background-color: white;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </content>
    </TitledPane>

    <Label text="Request items" styleClass="card-field-label"/>
    <ScrollPane fitToWidth="true" prefHeight="130.0" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="requestItemsContainer" spacing="8.0">
                <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                </padding>
                <Label text="Nessun request item disponibile" wrapText="true"/>
            </VBox>
        </content>
    </ScrollPane>

    <Label text="Messages" styleClass="card-field-label"/>
    <ScrollPane fitToWidth="true" prefHeight="130.0" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="messagesContainer" spacing="8.0">
                <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                </padding>
                <Label text="Nessun messaggio disponibile" wrapText="true"/>
            </VBox>
        </content>
    </ScrollPane>

    <Label text="Note" styleClass="card-field-label"/>
    <TextArea fx:id="noteArea"
              promptText="Eventuali note della richiesta"
              styleClass="mail-editable-field"
              style="-fx-control-inner-background: white; -fx-background-color: white;"
              wrapText="true"
              prefRowCount="8"
              VBox.vgrow="ALWAYS"/>
</VBox>
