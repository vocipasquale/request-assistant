<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Bozza richiesta -->

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      spacing="10.0" prefWidth="640.0" prefHeight="520.0" styleClass="pending-decision-card">

    <padding>
        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
    </padding>

    <HBox fx:id="bozzaRichiestaBox" spacing="8.0" alignment="CENTER_RIGHT" prefHeight="240.0">
        <Label text="Bozza richiesta" styleClass="card-section-label"/>
    </HBox>
</VBox>
