<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="LOG_PATH" source="log.path" />
    <springProperty scope="context" name="LOG_LEVEL" source="log.level" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%level|%logger{36}|messaggio=%msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE-TRACE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/RequestAssistant-trace.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>RequestAssistant-trace-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%level|%logger{36}|messaggio=%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.reactive.pinc.be.gestionerapporto" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE-TRACE" />
    </logger>

    <logger name="org.hibernate.type.descriptor.sql" level="TRACE" />
    <logger name="org.springframework.ws.client.MessageTracing.sent" level="${LOG_LEVEL}"/>
    <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level ="${LOG_LEVEL}"/>
    <logger name="org.hibernate.SQL_SLOW" level ="${LOG_LEVEL}"/>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE-TRACE"/>
    </root>

</configuration>
