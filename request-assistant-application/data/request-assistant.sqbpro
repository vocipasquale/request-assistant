SELECT m.* FROM message m
WHERE m.request_id = 1;


DELETE FROM message
WHERE id = ?
AND (request_id IS NOT NULL AND request_id &lt; 1);

DELETE FROM message
WHERE id = 1
AND NOT EXISTS (SELECT 1 FROM request WHERE id = request_id);</sql><current_tab id="0"/></tab_sql></sqlb_project>
