<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>it.requestassistant</groupId>
    <artifactId>request-assistant-runner</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>it.requestassistant</groupId>
        <artifactId>request-assistant</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>21</javafx.version>
        <fxweaver.version>2.0.1</fxweaver.version>
        <native.lib.dir>${project.basedir}/lib</native.lib.dir>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>net.rgielen</groupId>
            <artifactId>javafx-weaver-core</artifactId>
            <version>${fxweaver.version}</version>
        </dependency>

        <dependency>
            <groupId>it.requestassistant</groupId>
            <artifactId>request-assistant-application</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>it.requestassistant</groupId>
            <artifactId>request-assistant-batch</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>it.requestassistant</groupId>
            <artifactId>request-assistant-common</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>it.requestassistant</groupId>
            <artifactId>request-assistant-dashboard</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>it.requestassistant.RequestAssistantApplication</mainClass>
                    <additionalClasspathElements>
                        <additionalClasspathElement>
                            ${native.lib.dir}
                        </additionalClasspathElement>
                    </additionalClasspathElements>
                    <jvmArguments>
                        -Djava.library.path=${native.lib.dir}
                    </jvmArguments>
                    <!-- -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005 -->
                </configuration>
            </plugin>

            <!-- Plugin per eseguire l'applicazione JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>it.requestassistant.RequestAssistantApplication</mainClass>
                    <options>
                        <option>-Djava.library.path=${native.lib.dir}</option>
                    </options>
                </configuration>
            </plugin>

            <!-- Produce il pacchetto distribuibile: ZIP con fat-JAR + librerie native -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <finalName>request-assistant-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>